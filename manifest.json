{
  "manifest_version": 3,
  "name": "ThreadPilot for ChatGPT",
  "short_name": "ThreadPilot",
  "version": "3.0.1",
  "description": "Fold long ChatGPT replies and navigate every turn with a focused conversation timeline.",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ThreadPilot for ChatGPT",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/ui/*.svg"],
      "matches": ["https://chatgpt.com/*"]
    }
  ],
  "homepage_url": "https://billowssun.github.io/threadpilot-for-chatgpt/"
}
